{
  "synthetic": true,
  "schema_version": "1.0",
  "formula_contract": {
    "formula_version": "profit-workbook-au-weight-only-fba-v8",
    "fee_model_version": "au-user-workbook-weight-only-v1;us-sop-2023-weight-v1",
    "implementation": "lib/profit-model.mjs#calculateProductProfit",
    "representation": "declarative_data_only",
    "input_policy": "Use explicit product inputs. Do not apply consumer defaults or execute uploaded formula text.",
    "inputs": {
      "salePrice": {
        "unit": "marketplace_currency/sellable_unit",
        "positive": true
      },
      "purchaseCostCny": {
        "unit": "CNY/sellable_unit",
        "non_negative": true,
        "note": "Already piece-adjusted; do not multiply units_per_set again."
      },
      "fulfillmentFee": {
        "unit": "marketplace_currency/sellable_unit",
        "non_negative": true
      },
      "fulfillmentMode": {
        "values": [
          "FBA",
          "FBM"
        ]
      },
      "exchangeRate": {
        "unit": "CNY/1 marketplace_currency",
        "positive": true
      },
      "actualWeightKg": {
        "unit": "kg/sellable_unit",
        "positive": true
      },
      "dimensionsCm": {
        "unit": "cm",
        "nullable": true
      },
      "cartonWeightKg": {
        "unit": "kg/carton",
        "nullable": true
      },
      "unitsPerCarton": {
        "unit": "sellable_units/carton",
        "nullable": true
      },
      "airFreightActualWeightOnly": {
        "unit": "boolean"
      },
      "volumetricDivisor": {
        "unit": "cubic_inches/pound",
        "positive": true
      },
      "commissionRate": {
        "unit": "percent",
        "non_negative": true
      },
      "fxLossRate": {
        "unit": "percent",
        "non_negative": true
      },
      "marketingRate": {
        "unit": "percent",
        "non_negative": true
      },
      "managementRate": {
        "unit": "percent",
        "non_negative": true
      },
      "returnsRate": {
        "unit": "percent",
        "non_negative": true
      },
      "purchaseTaxRate": {
        "unit": "percent",
        "non_negative": true
      },
      "domesticFreightRateCnyPerKg": {
        "unit": "CNY/kg",
        "non_negative": true
      },
      "airFreightRateCnyPerKg": {
        "unit": "CNY/kg",
        "non_negative": true
      }
    },
    "equations": [
      {
        "output": "purchaseTaxCny",
        "expression": "purchaseCostCny * purchaseTaxRate / 100"
      },
      {
        "output": "domesticFreightCny",
        "expression": "actualWeightKg * domesticFreightRateCnyPerKg"
      },
      {
        "output": "landedPurchaseCny",
        "expression": "purchaseCostCny + purchaseTaxCny + domesticFreightCny"
      },
      {
        "output": "parts.purchase",
        "expression": "landedPurchaseCny / exchangeRate"
      },
      {
        "output": "dimensionalWeightKg",
        "expression": "product(dimensionsCm / 2.54) / volumetricDivisor / 2.2046226218",
        "condition": "actual-weight-only is false and dimensions exist"
      },
      {
        "output": "chargeableWeightKg",
        "expression": "actualWeightKg",
        "condition": "airFreightActualWeightOnly is true"
      },
      {
        "output": "chargeableWeightKg",
        "expression": "cartonWeightKg / unitsPerCarton",
        "condition": "actual-weight-only is false and both carton inputs are positive"
      },
      {
        "output": "chargeableWeightKg",
        "expression": "max(actualWeightKg, dimensionalWeightKg)",
        "condition": "actual-weight-only is false and carton inputs are incomplete; ignore absent dimensions"
      },
      {
        "output": "parts.freight",
        "expression": "chargeableWeightKg * airFreightRateCnyPerKg / exchangeRate"
      },
      {
        "output": "parts.commission",
        "expression": "salePrice * commissionRate / 100"
      },
      {
        "output": "parts.fxLoss",
        "expression": "salePrice * fxLossRate / 100"
      },
      {
        "output": "parts.marketing",
        "expression": "salePrice * marketingRate / 100"
      },
      {
        "output": "parts.management",
        "expression": "salePrice * managementRate / 100"
      },
      {
        "output": "parts.returns",
        "expression": "salePrice * returnsRate / 100"
      },
      {
        "output": "parts.fulfillment",
        "expression": "fulfillmentFee",
        "note": "Charge FBA or FBM once; parts.fba and parts.fbm are aliases, not extra fees."
      },
      {
        "output": "totalCost",
        "expression": "parts.purchase + parts.commission + parts.fulfillment + parts.freight + parts.fxLoss + parts.marketing + parts.management + parts.returns"
      },
      {
        "output": "profit",
        "expression": "salePrice - totalCost"
      },
      {
        "output": "margin",
        "expression": "profit / salePrice * 100"
      }
    ],
    "margin_denominator": "salePrice",
    "result_units": {
      "profit": "marketplace_currency/sellable_unit",
      "totalCost": "marketplace_currency/sellable_unit",
      "margin": "percent",
      "parts": "marketplace_currency/sellable_unit",
      "cny_suffix_fields": "CNY/sellable_unit"
    },
    "rounding": {
      "calculation": "IEEE-754 binary64; no intermediate or final rounding in calculateProductProfit",
      "display": "2 decimal places for money and percentage; exported result keeps precision",
      "upstream": "Keep already-resolved salePrice and piece-adjusted purchaseCostCny; do not derive again",
      "comparison_absolute_tolerance": 1e-9
    },
